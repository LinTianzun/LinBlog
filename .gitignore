# Dependencies
node_modules/
**/node_modules/
.pnpm-store/

# Local environment variables and secrets
.env
.env.*
!.env.example
!**/.env.example

# Build and test output
dist/
dist-ssr/
coverage/
playwright-report/
test-results/
playwright/.auth/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Generated database initialization markers
serve/model/.db_initialized*
serve/model/.mock_data_inserted*

# Runtime cover uploads. Bundled xw demo images stay tracked.
serve/data/img/*
!serve/data/img/xw*.jpg
!serve/data/img/xw*.png

# Operating system files
.DS_Store
Thumbs.db

# Local editor files
.vscode/
.idea/

# Temporary scratch dirs (headless Chrome profiles, one-off scripts/logs)
.tmp-*/

# Design exploration scratch output (direction sheets from design tooling)
.taste-skill/

# Runtime file uploads
serve/data/files/*
!serve/data/files/.gitkeep

# Non-public deleted-file backups
serve/storage/file-backups/*
!serve/storage/file-backups/.gitkeep

# Database dumps (contain user data, never commit)
serve/storage/db-backups/*
!serve/storage/db-backups/.gitkeep
