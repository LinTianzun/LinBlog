# Copy to .env and replace the JWT secret with a random value.
# Generate a secret with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
LINBLOG_JWT_SECRET=

# MySQL password; leave blank only if your local MySQL account has no password.
LINBLOG_DB_PASSWORD=

# Optional database connection settings.
LINBLOG_DB_HOST=localhost
LINBLOG_DB_USER=root
LINBLOG_DB_NAME=linlog

# Comma-separated browser origins allowed by CORS.
LINBLOG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum JSON request body size accepted by Express.
LINBLOG_JSON_LIMIT=1mb
