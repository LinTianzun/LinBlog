# Copy this file to serve/.env and fill in values for your deployment.
# Generate a random JWT secret with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
LINBLOG_JWT_SECRET=

# Comma-separated, exact browser origins (scheme + host + optional port).
# Do not include paths or trailing slashes. Never use * for credentialed APIs.
# Example: http://localhost:5173,https://blog.example.com
# On Railway this can be omitted when RAILWAY_PUBLIC_DOMAIN is available.
LINBLOG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional server port. PORT takes precedence on Railway and other PaaS hosts.
PORT=3030
LINBLOG_PORT=3030

# Public frontend origin used in password-reset links. Defaults to the first
# LINBLOG_ALLOWED_ORIGINS entry. Do not include a path or trailing slash.
# LINBLOG_PUBLIC_URL=https://blog.example.com

# Set when running behind a reverse proxy (Nginx etc.) so req.ip reflects the
# real client IP. Supports true/false, a positive integer (hops), or
# loopback/linklocal/uniquelocal. Leave unset for direct exposure.
# LINBLOG_TRUST_PROXY=1

# MySQL connection settings.
LINBLOG_DB_HOST=localhost
LINBLOG_DB_PORT=3306
LINBLOG_DB_USER=root
LINBLOG_DB_PASSWORD=
LINBLOG_DB_NAME=linlog

# Railway's MySQL plugin exposes MYSQLHOST/MYSQLPORT/MYSQLUSER/MYSQLPASSWORD/
# MYSQLDATABASE. They are used automatically when the LINBLOG_DB_* values above
# are left unset.

# Optional path to the built frontend. Defaults to lin_blog/dist.
# LINBLOG_FRONTEND_DIST=/app/lin_blog/dist

# Maximum JSON request body size accepted by Express.
LINBLOG_JSON_LIMIT=1mb

# Optional SMTP for password-reset emails. When SMTP is not configured, reset
# links are only printed in the server console for local development.
# LINBLOG_SMTP_HOST=smtp.example.com
# LINBLOG_SMTP_PORT=587
# LINBLOG_SMTP_SECURE=false
# LINBLOG_SMTP_USER=no-reply@example.com
# LINBLOG_SMTP_PASSWORD=
# LINBLOG_SMTP_FROM=LinBlog <no-reply@example.com>

# Optional: IP geolocation lookup for visit records. Leave unset to keep
# record.position NULL (default). The URL may contain "{ip}" as a placeholder.
# LINBLOG_GEOIP_URL=https://ipapi.co/{ip}/json/
# LINBLOG_GEOIP_TIMEOUT_MS=1500

# Optional: how many days of visit records to keep (default 90). Minimum 1.
# LINBLOG_RECORD_RETENTION_DAYS=90

# Optional: how many days deleted file backups are kept (default 30). Minimum 1.
# LINBLOG_FILE_BACKUP_RETENTION_DAYS=30

# Optional: how many hours an unreferenced active file must exist before cleanup
# can remove it (default 24). Minimum 1.
# LINBLOG_FILE_ORPHAN_GRACE_HOURS=24

# Optional storage overrides. Defaults:
# LINBLOG_FILE_STORAGE_DIR=serve/data/files
# LINBLOG_FILE_BACKUP_DIR=serve/storage/file-backups
# Railway example after mounting a volume at /data:
# LINBLOG_FILE_STORAGE_DIR=/data/files
# LINBLOG_FILE_BACKUP_DIR=/data/file-backups

# Optional: backup capacity warning (default 2 GiB, warn at 80%).
# LINBLOG_FILE_BACKUP_MAX_BYTES=2147483648
# LINBLOG_FILE_BACKUP_WARN_PERCENT=80

# Optional: copy every deleted file backup to another disk/mount.
# The directory must be writable by the server process.
# LINBLOG_FILE_BACKUP_MIRROR_DIR=D:/linblog-backup-mirror

# Optional: database logical backups (scheduled + manual).
# Images are stored as MEDIUMBLOB inside MySQL, so file backups alone cannot
# restore a site. Backups are gzip-compressed JSONL dumps written by the server
# process itself; no mysqldump client is required.
# Defaults to serve/storage/db-backups. On Railway mount a volume, e.g. /data/db-backups.
# LINBLOG_DB_BACKUP_DIR=/data/db-backups
# How many backup files to keep (default 7). Older files are pruned after each run.
# LINBLOG_DB_BACKUP_RETENTION=7
# Local hour (0-23) of the daily scheduled backup (default 3 = 03:00).
# LINBLOG_DB_BACKUP_HOUR=3
# Rows read per chunk per table (default 200, max 5000).
# LINBLOG_DB_BACKUP_CHUNK_SIZE=200
# Timeout for a single backup or restore run in milliseconds (default 10 minutes).
# LINBLOG_DB_DUMP_TIMEOUT_MS=600000
# Optional capacity warning: total bytes of the backup directory and the
# percentage at which the UI switches to warning/critical (default 80).
# LINBLOG_DB_BACKUP_MAX_BYTES=2147483648
# LINBLOG_DB_BACKUP_WARN_PERCENT=80

# Optional: S3-compatible object storage. The current client uses
# path-style URLs: {endpoint}/{bucket}/{prefix}/{filename}.
# All five credential fields must be present to enable it.
# LINBLOG_S3_ENDPOINT=https://s3.example.com
# LINBLOG_S3_BUCKET=linblog
# LINBLOG_S3_REGION=us-east-1
# LINBLOG_S3_ACCESS_KEY_ID=
# LINBLOG_S3_SECRET_ACCESS_KEY=
# LINBLOG_S3_PREFIX=file-backups
